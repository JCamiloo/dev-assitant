# DevAssistant - Environment Variables

# === API Keys ===
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# === Model Configuration ===
# Options: anthropic | openai
MODEL_PROVIDER=anthropic

# Anthropic model to use (options: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI model to use (options: gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# OpenAI embeddings model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === RAG ===
# Directory where the documentation to index is located
DOCS_PATH=./docs/sample-project

# Path to the vector database
DB_PATH=./data/vectors.db

# Number of chunks to retrieve per search
RAG_TOP_K=5